@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<section class="seccion">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <h2 class="titulo-seccion mb-0">Administrar categorías</h2>
            <a class="btn btn-hero" asp-action="Create">➕ Nueva categoría</a>
        </div>

        <div class="table-responsive tabla-saltinas">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ícono</th>
                        <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                        <th class="text-center">Productos</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td class="fs-4">@categoria.Icono</td>
                            <td class="fw-semibold">@categoria.Nombre</td>
                            <td class="text-center">@categoria.Productos.Count</td>
                            <td class="text-end acciones-tabla">
                                <a class="btn btn-sm btn-accion" asp-action="Details" asp-route-id="@categoria.Id">Ver productos</a>
                                <a class="btn btn-sm btn-accion" asp-action="Edit" asp-route-id="@categoria.Id">Editar</a>
                                <a class="btn btn-sm btn-accion btn-accion-peligro" asp-action="Delete" asp-route-id="@categoria.Id">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
