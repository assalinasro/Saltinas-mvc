@model Categoria
@{
    ViewData["Title"] = "Editar categoría";
}

<section class="seccion">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="titulo-seccion">Editar categoría ✏️</h2>

                <div class="tarjeta-info">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                        <input type="hidden" asp-for="Id" />
                        <partial name="_CamposCategoria" model="Model" />

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-registrar">Guardar cambios 💗</button>
                            <a class="btn btn-hero-outline" asp-action="Index">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
