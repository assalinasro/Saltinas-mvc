@model Categoria
@{
    ViewData["Title"] = Model.Nombre;
}

<section class="seccion">
    <div class="container">
        <h2 class="titulo-seccion">@Model.Icono @Model.Nombre</h2>
        <p class="lead-saltinas">Esta categoría tiene <strong>@Model.Productos.Count</strong> producto(s) asociados.</p>

        @if (Model.Productos.Any())
        {
            <div class="table-responsive tabla-saltinas mb-4">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model.Productos.OrderBy(p => p.Nombre))
                        {
                            <tr>
                                <td class="fw-semibold">@producto.Nombre</td>
                                <td class="text-end">@producto.PrecioFormateado</td>
                                <td class="text-end acciones-tabla">
                                    <a class="btn btn-sm btn-accion" asp-controller="Productos" asp-action="Details" asp-route-id="@producto.Id">Ver</a>
                                    <a class="btn btn-sm btn-accion" asp-controller="Productos" asp-action="Edit" asp-route-id="@producto.Id">Editar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a class="btn btn-hero-outline" asp-action="Index">Volver a categorías</a>
    </div>
</section>
