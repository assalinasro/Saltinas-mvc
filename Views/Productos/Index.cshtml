@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
    var buscar = ViewData["Buscar"] as string;
}

<section class="seccion">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
            <h2 class="titulo-seccion mb-0">Administrar productos</h2>
            <a class="btn btn-hero" asp-action="Create">➕ Nuevo producto</a>
        </div>

        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-sm-8 col-md-6">
                <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-registrar">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(buscar))
                {
                    <a class="btn btn-hero-outline ms-1" asp-action="Index">Limpiar</a>
                }
            </div>
        </form>

        @if (!Model.Any())
        {
            <p class="text-center text-muted">No hay productos que mostrar.</p>
        }
        else
        {
            <div class="table-responsive tabla-saltinas">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                            <th>@Html.DisplayNameFor(m => m.CategoriaId)</th>
                            <th class="text-end">@Html.DisplayNameFor(m => m.Precio)</th>
                            <th class="text-center">Destacada</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@Url.Content("~/" + producto.Imagen)" alt="@producto.Nombre" class="mini-foto-tabla"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/img/placeholder.svg")';" />
                                </td>
                                <td class="fw-semibold">@producto.Nombre</td>
                                <td><span class="pildora-categoria">@producto.Categoria?.Icono @producto.Categoria?.Nombre</span></td>
                                <td class="text-end">@producto.PrecioFormateado</td>
                                <td class="text-center">@(producto.Destacado ? "⭐" : "—")</td>
                                <td class="text-end acciones-tabla">
                                    <a class="btn btn-sm btn-accion" asp-action="Details" asp-route-id="@producto.Id">Ver</a>
                                    <a class="btn btn-sm btn-accion" asp-action="Edit" asp-route-id="@producto.Id">Editar</a>
                                    <a class="btn btn-sm btn-accion btn-accion-peligro" asp-action="Delete" asp-route-id="@producto.Id">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
