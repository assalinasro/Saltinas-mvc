@model Producto

<div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

<div class="col-md-6">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej: Jean cadera baja azul" />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="CategoriaId" class="form-label"></label>
    <!-- Lista desplegable: las opciones salen de la tabla Categorias -->
    <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
        <option value="0">Selecciona una categoría...</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="Precio" class="form-label"></label>
    <input asp-for="Precio" type="number" min="1000" step="1000" class="form-control" placeholder="Ej: 129000" />
    <span asp-validation-for="Precio" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="Imagen" class="form-label"></label>
    <input asp-for="Imagen" class="form-control" placeholder="Imagenes/jean1.jpeg" />
    <span asp-validation-for="Imagen" class="text-danger small"></span>
    <div class="form-text">Debe ser una imagen que esté dentro de la carpeta wwwroot.</div>
</div>

<div class="col-12">
    <div class="form-check">
        <input asp-for="Destacado" class="form-check-input" />
        <label asp-for="Destacado" class="form-check-label"></label>
    </div>
</div>
