@model Producto
@{
    ViewData["Title"] = "Nuevo producto";
}

<section class="seccion">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <h2 class="titulo-seccion">Nuevo producto ➕</h2>

                <div class="tarjeta-info">
                    <form asp-action="Create" method="post" class="row g-3">
                        <partial name="_CamposProducto" model="Model" />

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-registrar">Guardar 💗</button>
                            <a class="btn btn-hero-outline" asp-action="Index">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
